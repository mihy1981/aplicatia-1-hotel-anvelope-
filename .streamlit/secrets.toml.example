# Copiază acest fișier ca .streamlit/secrets.toml (local) sau lipește conținutul
# în Streamlit Cloud → aplicația ta → Settings → Secrets.
# NU pune fișierul secrets.toml și nici cheia JSON pe GitHub!

# ID-ul tabelului Google Sheets (partea din link dintre /d/ și /edit)
spreadsheet_id = "1qs5DuQ4--vT0Tr91sqH2om4B1dHM_-IyNLnkcvL5leA"

# foaia GY citită (doar citire) la prima pornire
source_sheet = "Inventar GY"

# true = mod DEMO cu fișiere CSV locale, fără Google (pentru test)
demo_mode = false

# Profil sub care se recomandă anvelope noi (mm)
worn_threshold_mm = 3.0

# Zile de depozitare incluse în preț; peste acest termen -> facturare suplimentară
storage_days_limit = 180

# Variantă A (recomandată, obligatorie pe Streamlit Cloud): conținutul fișierului JSON
# al contului de serviciu, câmp cu câmp. Copiază valorile din fișierul descărcat.
[gcp_service_account]
type = "service_account"
project_id = "proiectul-tau"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nLIPESTE_AICI_CHEIA\n-----END PRIVATE KEY-----\n"
client_email = "hotel-anvelope@proiectul-tau.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/hotel-anvelope%40proiectul-tau.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# Variantă B (doar local): în loc de secțiunea de mai sus, calea spre fișierul JSON.
# Șterge secțiunea [gcp_service_account] și pune linia de mai jos ÎNAINTE de orice secțiune [..].
# gcp_service_account_file = "hotel-anvelope-madyt-cheie.json"
